rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.appAccess == true
        && request.auth.token.isDeleted != true;
    }

    function isAdmin() {
      return isVerifiedMember() && request.auth.token.role == 'Admin';
    }

    function hasPermission(permission) {
      return isAdmin()
        || (isVerifiedMember()
          && request.auth.token.permissions is list
          && permission in request.auth.token.permissions);
    }

    function canDelete(module) {
      return hasPermission(module) && hasPermission('can_delete');
    }

    function validId(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{1,128}$');
    }

    match /auditLogs/{logId} {
      allow get, list: if hasPermission('audit');
      allow create: if isVerifiedMember()
        && validId(logId)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow get, list: if isVerifiedMember()
        && (hasPermission('dashboard') || resource.data.authUid == request.auth.uid);
      allow create: if isAdmin() && validId(userId);
      allow update: if isAdmin()
        || (isVerifiedMember()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'isOnline', 'lastActiveAt', 'updatedAt', 'fullName', 'phone', 'photoUrl'
            ]));
      allow delete: if isAdmin();
    }

    match /presences/{userId} {
      allow get, list: if hasPermission('dashboard');
      allow create, update: if isVerifiedMember()
        && request.resource.data.email == request.auth.token.email
        && userId == request.auth.token.email;
      allow delete: if isVerifiedMember()
        && userId == request.auth.token.email;
    }

    match /clients/{id} {
      allow read: if hasPermission('clients');
      allow create, update: if hasPermission('clients') && validId(id);
      allow delete: if canDelete('clients') && validId(id);
    }

    match /cases/{id} {
      allow read: if hasPermission('cases');
      allow create, update: if hasPermission('cases') && validId(id);
      allow delete: if canDelete('cases') && validId(id);
    }

    match /events/{id} {
      allow read: if hasPermission('events');
      allow create, update: if hasPermission('events') && validId(id);
      allow delete: if canDelete('events') && validId(id);
    }

    match /avocats/{id} {
      allow read: if hasPermission('avocats');
      allow create: if hasPermission('avocats') && validId(id);
      allow update: if (hasPermission('avocats')
          || (isVerifiedMember()
            && resource.data.emails is list
            && request.auth.token.email in resource.data.emails
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'phone', 'photoUrl'])))
        && validId(id);
      allow delete: if canDelete('avocats') && validId(id);
    }

    match /personnels/{id} {
      allow read: if hasPermission('personnels');
      allow create: if hasPermission('personnels') && validId(id);
      allow update: if (hasPermission('personnels')
          || (isVerifiedMember()
            && resource.data.email == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['fullName', 'phone', 'photoUrl'])))
        && validId(id);
      allow delete: if canDelete('personnels') && validId(id);
    }

    match /fournisseurs/{id} {
      allow read: if hasPermission('suppliers');
      allow create, update: if hasPermission('suppliers') && validId(id);
      allow delete: if canDelete('suppliers') && validId(id);
    }

    match /tasks/{id} {
      allow read: if hasPermission('agenda');
      allow create, update: if hasPermission('agenda') && validId(id);
      allow delete: if canDelete('agenda') && validId(id);
    }

    match /invoices/{id} {
      allow read: if hasPermission('billing');
      allow create, update: if hasPermission('billing') && validId(id);
      allow delete: if canDelete('billing') && validId(id);
    }

    match /correspondances/{id} {
      allow read: if hasPermission('correspondance');
      allow create, update: if hasPermission('correspondance') && validId(id);
      allow delete: if canDelete('correspondance') && validId(id);
    }

    match /chat_messages/{id} {
      allow read: if hasPermission('chat');
      allow create: if hasPermission('chat')
        && validId(id)
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email;
      allow update: if hasPermission('chat')
        && resource.data.senderUid == request.auth.uid
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.senderEmail == request.auth.token.email;
      allow delete: if isAdmin()
        || (hasPermission('chat') && resource.data.senderUid == request.auth.uid);
    }

    match /forum_topics/{id} {
      allow read: if hasPermission('chat');
      allow create: if hasPermission('chat')
        && validId(id)
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if hasPermission('chat')
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /cabinet_info/{id} {
      allow read: if hasPermission('gestion_cabinet');
      allow create, update: if hasPermission('gestion_cabinet') && validId(id);
      allow delete: if isAdmin() && validId(id);
    }

    match /system_settings/{id} {
      allow read: if hasPermission('gestion_cabinet');
      allow create, update: if hasPermission('gestion_cabinet') && validId(id);
      allow delete: if isAdmin() && validId(id);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
